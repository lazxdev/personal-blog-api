generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String     @unique
  content     String
  tags        String[]
  category    String?
  status      PostStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
}
